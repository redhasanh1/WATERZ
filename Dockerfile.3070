# ============================================================================
# RTX 3070 Docker Image - ProPainter + RUN_SAM2_LOCAL
# ============================================================================
# Now supports full RUN_SAM2_LOCAL.py pipeline with:
# - YOLO watermark detection (ultralytics)
# - NVENC hardware video encoding (h264_nvenc)
# - torch.compile optimization (GCC for Triton)
# ============================================================================

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# ============================================================================
# SYSTEM DEPENDENCIES
# ============================================================================

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    gcc \
    g++ \
    ffmpeg \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libgomp1 \
    git \
    wget \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# PYTHON DEPENDENCIES
# ============================================================================

# PyTorch with CUDA 12.8 (nightly for better driver compatibility)
RUN pip install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/nightly/cu128

# Other dependencies
COPY requirements-docker-3070.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-docker-3070.txt

# Add ultralytics for YOLO watermark detection
RUN pip install --no-cache-dir ultralytics

# ============================================================================
# APPLICATION CODE
# ============================================================================

WORKDIR /app

# Copy main worker script
COPY celery_3070_worker.py /app/
COPY cache_config.py /app/

# Copy RUN_SAM2_LOCAL and dependencies
COPY RUN_SAM2_LOCAL.py /app/
COPY crop_utils.py /app/
COPY segment_detector.py /app/
COPY yolo_detector.py /app/

# Copy ProPainter code (entire faster-propainter-main directory)
COPY faster-propainter-main/ /app/faster-propainter-main/

# ============================================================================
# MODEL WEIGHTS - CRITICAL (BAKED INTO IMAGE)
# ============================================================================

# Create weights directory
RUN mkdir -p /app/weights

# Copy all ProPainter model weights
COPY weights/ProPainter.pth /app/weights/
COPY weights/raft-things.pth /app/weights/
COPY weights/recurrent_flow_completion.pth /app/weights/

# Copy serialized/optimized models
COPY weights/propainter_encoder_aot.ts /app/weights/
COPY weights/rfcnet_downsampler_aot.ts /app/weights/

# Copy YOLO watermark detection model
RUN mkdir -p /app/runs/detect/new_sora_watermark/weights
COPY runs/detect/new_sora_watermark/weights/best.pt /app/runs/detect/new_sora_watermark/weights/

# Verify all required models exist (fail build if missing)
RUN python -c "import os; \
    models = ['ProPainter.pth', 'raft-things.pth', 'recurrent_flow_completion.pth']; \
    missing = [m for m in models if not os.path.exists(f'/app/weights/{m}')]; \
    assert not missing, f'Missing models: {missing}'"

# Verify YOLO model exists
RUN python -c "import os; assert os.path.exists('/app/runs/detect/new_sora_watermark/weights/best.pt'), 'YOLO model missing'"

# ============================================================================
# WORKING DIRECTORIES
# ============================================================================

RUN mkdir -p /app/temp /app/results /app/uploads /app/masks /data/cache

# ============================================================================
# ENVIRONMENT VARIABLES - RTX 3070 OPTIMIZATIONS
# ============================================================================

# RTX 3070 doesn't support Flash Attention 3
ENV ENABLE_FLASH_ATTENTION=0

# Disable optional accelerations that require custom packages
ENV ENABLE_SAGE_ATTENTION=0
ENV ENABLE_FP8_TRANSFORMER=0
ENV ENABLE_DCNV4_RFCNET=0

# Disable torch.compile - Triton compilation fails on Salad runtime images
ENV USE_TORCH_COMPILE=0
ENV USE_TORCH_COMPILE_RAFT=0
ENV TORCHDYNAMO_DISABLE=1

# CUDA graphs can cause issues, disable for stability
ENV TORCH_CUDAGRAPHS=0
ENV TORCHINDUCTOR_CUDAGRAPHS=0

# Use PyTorch backends (more stable than TensorRT)
ENV FORCE_TRT_RAFT=0
ENV FORCE_TRT_RFCNET=0
ENV USE_NEUFLOW=0
ENV PROPAINTER_FLOW_BACKEND=raft

# FP16 for memory efficiency on 8GB VRAM
ENV USE_FP16=1

# Cache directories
ENV TORCH_HOME=/data/cache
ENV HF_HOME=/data/cache
ENV TORCHINDUCTOR_CACHE_DIR=/data/cache/.torch_inductor
ENV TRITON_CACHE_DIR=/data/cache/.triton

# Python path - include /app for RUN_SAM2_LOCAL imports
ENV PYTHONPATH=/app:/app/faster-propainter-main

# C compiler for torch.compile/Triton
ENV CC=gcc

# NVIDIA Container Toolkit - rely on base image defaults for better compatibility

# ============================================================================
# HEALTHCHECK
# ============================================================================

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import torch; print('OK')" || exit 1

# ============================================================================
# DEFAULT COMMAND
# ============================================================================

# Default: run as Celery worker on processing queue
CMD ["python", "-m", "celery", "-A", "celery_3070_worker", "worker", \
     "--queues=processing", \
     "--concurrency=1", \
     "--loglevel=info", \
     "--pool=solo"]
