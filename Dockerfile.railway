# Railway Web Frontend - CPU only (no GPU/CUDA/TensorRT)
# GPU processing happens on local PC via Celery workers

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (no libgl1-mesa-glx needed - using opencv-python-headless)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from requirements.txt
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy only web-related files
COPY server_production.py .
COPY web ./web

# Create necessary directories
RUN mkdir -p temp uploads results cache

# Environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    RAILWAY=1

# Expose port (Railway uses PORT env var)
EXPOSE 8080

# Run with gunicorn (Railway sets PORT automatically)
CMD ["sh", "-c", "gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --timeout 120 server_production:app"]
