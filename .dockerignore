# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo

# Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
ENV/
env/

# Temporary files
temp/*
!temp/.gitkeep
uploads/*
!uploads/.gitkeep
results/*
!results/.gitkeep
cache/*
!cache/.gitkeep
pip_cache/*
!pip_cache/.gitkeep

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documentation
*.md
!README.md
docs/

# Test files
tests/
test_*.py
*_test.py

# Build artifacts
*.pt
*.pth
*.safetensors

# TensorRT engines - EXCLUDE! (platform-specific, must be built in container)
*.engine
**/*.engine

# EXCEPTION: Pre-built WSL engines for 4090 (skip 15min rebuild on WSL)
!engines_trt/*.engine
!engines_trt/**/*.engine

# ONNX models - KEEP these for TRT engine building
!faster-propainter-main/models/neuflow_things.onnx
!engines/rfcnet/rfcnet_dcnv4.onnx

# Keep YOLO weights
!runs/detect/new_sora_watermark/weights/best.pt

# Node.js (if any)
node_modules/
package-lock.json

# Windows batch files (not needed in Docker)
*.bat

# Claude Code
.claude/

# Misc
nul
*.zip
*.tar.gz
*.tgz
redis*.exe
redis*.pdb
redis*.dll
EventLog.dll
