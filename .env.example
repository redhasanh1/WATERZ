# WatermarkAI Environment Configuration - Railway Deployment
# Copy this to .env if you need to override default settings

# ============================================================================
# Railway Redis (auto-loaded from redis_url.txt)
# ============================================================================
# Optional: Override Redis URL (otherwise uses redis_url.txt)
# Get this from Railway Redis service dashboard
# REDIS_URL=redis://default:password@redis.railway.internal:6379

# ============================================================================
# Railway uses persistent volumes (/data) - no AWS credentials needed!
# ============================================================================

# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-this-in-production

# Server settings
HOST=0.0.0.0
PORT=9000

# Celery workers
CELERY_CONCURRENCY=2

# GPU settings (leave empty for auto-detect)
CUDA_VISIBLE_DEVICES=0

# Processing limits
MAX_FILE_SIZE=104857600
MAX_VIDEO_LENGTH=600

# Paths (automatically set by server, but can override)
# TEMP_DIR=D:\github\RoomFinderAI\watermarkz\temp
# CACHE_DIR=D:\github\RoomFinderAI\watermarkz\cache
# UPLOAD_DIR=D:\github\RoomFinderAI\watermarkz\uploads
# RESULT_DIR=D:\github\RoomFinderAI\watermarkz\results

# Model optimization
USE_TENSORRT=False
USE_FP16=True

# Monitoring (optional)
SENTRY_DSN=
