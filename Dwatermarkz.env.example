# ============================================================================
# Environment Configuration for Watermark Removal SaaS
# Copy this file to .env and fill in your actual values
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL - required for authentication)
# ----------------------------------------------------------------------------
# Get from Railway PostgreSQL addon or your database provider
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ----------------------------------------------------------------------------
# Flask Secret Key (required for sessions)
# ----------------------------------------------------------------------------
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-secret-key-here-use-secrets-token-hex-32

# ----------------------------------------------------------------------------
# Google OAuth (required for "Sign in with Google")
# ----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----------------------------------------------------------------------------
# Stripe (required for payment processing)
# ----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_or_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Product IDs for credit packages (create these in Stripe Dashboard)
STRIPE_PRICE_5_CREDITS=price_xxxxxxxxxxxxx
STRIPE_PRICE_20_CREDITS=price_xxxxxxxxxxxxx
STRIPE_PRICE_50_CREDITS=price_xxxxxxxxxxxxx
STRIPE_PRICE_100_CREDITS=price_xxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# Redis (required for Celery task queue)
# ----------------------------------------------------------------------------
# Get from Railway Redis addon or your Redis provider
REDIS_URL=redis://default:password@host:port

# ----------------------------------------------------------------------------
# ProPainter Flow Backend (optional)
# ----------------------------------------------------------------------------
# Options: 'raft' (default, slower but accurate) or 'fastflownet' (faster)
PROPAINTER_FLOW_BACKEND=raft

# ----------------------------------------------------------------------------
# Segmentation Workers (optional)
# ----------------------------------------------------------------------------
# Number of parallel workers for multi-GPU segmentation
SEGMENT_WORKERS=2

# ----------------------------------------------------------------------------
# Access Logs (optional)
# ----------------------------------------------------------------------------
# Enable detailed per-request access logs (1=on, 0=off)
ACCESS_LOGS=0

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# Railway PostgreSQL Setup:
# 1. Add PostgreSQL addon in Railway dashboard
# 2. DATABASE_URL will be automatically set
# 3. Run setup_database.py to create tables
#
# Google OAuth Setup:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: https://markremoverai.com/auth/google/callback
# 4. Copy Client ID and Secret to .env
#
# Stripe Setup:
# 1. Create products in Stripe Dashboard (e.g., "5 Credits - $2")
# 2. Copy price IDs to .env
# 3. Set up webhook endpoint: https://markremoverai.com/webhook/stripe
# 4. Copy webhook secret to .env
#
# Redis Setup (Railway):
# 1. Add Redis addon in Railway dashboard
# 2. REDIS_URL will be automatically set
#
# Security Checklist:
# - NEVER commit .env to git (it's in .gitignore)
# - Use strong random FLASK_SECRET_KEY
# - Use HTTPS in production (SESSION_COOKIE_SECURE=True requires it)
# - Rotate secrets regularly
# - Use Stripe test keys for development
#
# ============================================================================
